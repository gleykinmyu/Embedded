# libs/* вне PlatformIO-проекта — своя база: compile_commands.json рядом.
# Перегенерация: python3 libs/gen-compile-commands.py
#
# Override (свой тулчейн / проект):
#   board/mega2560 — AVR gen-compile-commands.ps1
#   dmx            — ../../DMX (PlatformIO compiledb)

CompileFlags:
  CompilationDatabase: .
